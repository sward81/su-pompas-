<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name> 
			<tr>Su Pompası</tr>
			<en>Water Pump</en>
		</name>
        <functions>
            <function>$l10n_function_SMBNFM</function>
        </functions>
        <image>store_waterpump.dds</image>
        <price>99000</price>
		<dailyUpkeep>900</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
        <vertexBufferMemoryUsage>1505280</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>364032</indexBufferMemoryUsage>
        <textureMemoryUsage>3866624</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <audioMemoryUsage>0</audioMemoryUsage>
    </storeData>

    <base>
        <filename>waterpump.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" >
        <testAreas>
            <testArea startNode="testAreaStart01" endNode="testAreaEnd01" />
        </testAreas>

        <sounds>
            <place template="smallImp" />
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearAreaStart01" widthNode="clearAreaWidth01" heightNode="clearAreaHeight01"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30" >
        <levelAreas>
            <levelArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01"/>
        </levelAreas>

        <paintAreas>
             <paintArea startNode="levelAreaStart01" widthNode="levelAreaWidth01" heightNode="levelAreaHeight01" groundType="asphalt1"/>
        </paintAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01"/>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01"/>
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger" />

    <productionPoint>
        <productions sharedThroughputCapacity="true">
            <production id="water1" name="$l10n_fillType_B1"  cyclesPerHour="5" costsPerActiveHour="0" autoOff="false">
                <inputs>
					<!-- <input fillType="DIESEL" amount="1"/> -->
				</inputs>
				<outputs>
					<output fillType="WATER" amount="5000"/>
				</outputs>
            </production>

            <production id="water2" name="$l10n_fillType_B2"  cyclesPerHour="5" costsPerActiveHour="0" autoOff="false">
                <inputs>
				<!--	<input fillType="DIESEL" amount="1"/> -->
				</inputs>
				<outputs>
					<output fillType="WATER" amount="5000"/>
				</outputs>
            </production>

            <production id="water3" name="$l10n_fillType_B3"  cyclesPerHour="5" costsPerActiveHour="0" autoOff="false">
                <inputs>
				<!--	<input fillType="DIESEL" amount="1"/> -->
				</inputs>
				<outputs>
					<output fillType="WATER" amount="5000"/>
				</outputs>
            </production>
        </productions>

        <storage isExtension="false" fillLevelSyncThreshold="50" >
            <!--<capacity fillType="DIESEL"       	capacity="1000" /> -->
            <capacity fillType="WATER"     	capacity="10000000" />
			<startFillLevel fillType="DIESEL" fillLevel="50"/>
        </storage>

        <effectNodes>
        </effectNodes>

        <sellingStation node="sellingStation" supportsExtension="false" >
            <unloadTrigger exactFillRootNode="exactFillNode" aiNode="unloadTriggerMarker" fillTypes="DIESEL WATER"/>
        </sellingStation>

        <loadingStation node="loadingStation" supportsExtension="false">
            <loadTrigger fillTypes="WATER" triggerNode="loadTrigger" fillLitersPerSecond="3500" dischargeNode="loadStation" aiNode="loadStation" />
        </loadingStation>

        <playerTrigger node="playerTrigger" />

        <sounds>
            <idle   template="dairyIdle" linkNode="0>" volumeScale="0.6" />
            <active template="dairyWork" linkNode="0>" volumeScale="0.6" />
        </sounds>
    </productionPoint>

    <triggerMarkers>
        <triggerMarker node="playerTriggerMarker"         adjustToGround="true"  filename="$data/shared/assets/marker/markerIconWrench.i3d" />
        <triggerMarker node="unloadTriggerMarker"         adjustToGround="true"  filename="$data/shared/assets/marker/markerIconUnload.i3d" />
        <triggerMarker node="loadTriggerMarker"         	  adjustToGround="true"  filename="$data/shared/assets/marker/markerIconLoad.i3d" />
    </triggerMarkers>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="sellingStation" teleportNode="teleportNode" />
    </hotspots>

    <i3dMappings>
        <i3dMapping id="clearAreaStart01" node="0>0|0" />
        <i3dMapping id="clearAreaWidth01" node="0>0|0|0" />
        <i3dMapping id="clearAreaHeight01" node="0>0|0|1" />
        <i3dMapping id="levelAreaStart01" node="0>1|0" />
        <i3dMapping id="levelAreaWidth01" node="0>1|0|0" />
        <i3dMapping id="levelAreaHeight01" node="0>1|0|1" />
        <i3dMapping id="indoorAreaStart01" node="0>2|0" />
        <i3dMapping id="indoorAreaWidth01" node="0>2|0|0" />
        <i3dMapping id="indoorAreaHeight01" node="0>2|0|1" />
        <i3dMapping id="testAreaStart01" node="0>3|0" />
        <i3dMapping id="testAreaEnd01" node="0>3|0|0" />
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>4|0" />
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>4|0|0" />
        <i3dMapping id="sellingStation" node="0>5" />
        <i3dMapping id="loadStation" node="0>5|0" />
        <i3dMapping id="loadTrigger" node="0>5|0|0" />
        <i3dMapping id="loadTriggerMarker" node="0>5|0|1" />
        <i3dMapping id="exactFillNode" node="0>5|1" />
        <i3dMapping id="unloadTriggerMarker" node="0>5|2" />
        <i3dMapping id="PRODUCTION_POINT" node="0>6" />
        <i3dMapping id="playerTrigger" node="0>6|0" />
        <i3dMapping id="playerTriggerMarker" node="0>6|0|0" />
        <i3dMapping id="teleportNode" node="0>6|1" />
        <i3dMapping id="infoTrigger" node="0>6|2" />
    </i3dMappings>
</placeable>
